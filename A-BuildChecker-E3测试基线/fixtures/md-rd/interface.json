{
  "project": {
    "id": "e3-buildchecker-md-rd",
    "version": "2026-09-10",
    "version_label": "e3-buildchecker-md-rd@2026-09-10",
    "project_root": "A-BuildChecker-E3测试基线/fixtures/md-rd",
    "platform": "linux",
    "network_required": false
  },
  "inputs": [
    "main.c",
    "config.h",
    "unused.h",
    "Makefile",
    "README.md",
    "interface.json"
  ],
  "build": {
    "command": "make",
    "exit_code": 0,
    "artifacts": [
      {
        "path": "app",
        "kind": "executable",
        "required": true
      }
    ]
  },
  "verify": {
    "command": "./app",
    "exit_code": 0,
    "stdout": "1\n",
    "stdout_match": "exact",
    "stderr_match": "record_only"
  },
  "clean_build": {
    "commands": ["make clean", "make"],
    "each_exit_code": 0
  },
  "oracle": {
    "scope": "project-headers-of-main.o",
    "findings": [
      {
        "type": "MISSING",
        "target": "main.o",
        "dependency": "config.h"
      },
      {
        "type": "REDUNDANT",
        "target": "main.o",
        "dependency": "unused.h"
      }
    ]
  }
}
