FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        make \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

COPY fixtures/draft/main.c fixtures/draft/Makefile ./

RUN make \
    && test -x ./hello

CMD ["./hello"]
